+def _comment_authority_digest(comment: dict[str, Any]) -> str | None:
+    """Hash only comment fields that can affect dispatch authority classification."""
+    body = comment.get("body")
+    if body is None:
+        body = ""
+    association = comment.get("author_association")
+    if association is None:
+        association = ""
+    user = comment.get("user")
+    if user is None:
+        login = ""
+        user_type = ""
+    elif isinstance(user, dict):
+        login = user.get("login")
+        user_type = user.get("type")
+        if login is None:
+            login = ""
+        if user_type is None:
+            user_type = ""
+    else:
+        return None
+    if not all(
+        isinstance(value, str)
+        for value in (body, association, login, user_type)
+    ):
+        return None
+
+    # Normalize only dimensions whose downstream classification is itself
+    # case-insensitive; keep body exact because claim/credential semantics are
+    # derived from its concrete representation.
+    authority_view = (
+        body,
+        association.upper(),
+        login.casefold(),
+        user_type.casefold(),
+    )
+    encoded = json.dumps(
+        authority_view,
+        ensure_ascii=False,
+        separators=(",", ":"),
+    ).encode("utf-8")
+    return hashlib.sha256(encoded).hexdigest()
+
+
