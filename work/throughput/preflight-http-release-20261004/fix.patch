+        try:
+            response = session.get(url, headers=headers, params=params, timeout=15)
+            response.raise_for_status()
+        except requests.RequestException as exc:
+            # Hooks may raise before get returns. Error responses are falsey.
+            if response is None:
+                response = getattr(exc, "response", None)
+            if response is not None:
+                try:
+                    # Retain the ordinary eager-response body for callers that
+                    # inspect cooldown messages after catching the HTTP error.
+                    # Streamed/hook failures must still release their pool slot.
+                    response.content
