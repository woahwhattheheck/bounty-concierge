  "finding": {
    "id": "canonical-map-npcs-never-enter-runtime-base",
    "severity": "blocking_acceptance_invariant",
    "statement": "The carrier persists game_maps.data.npcs but runtime LoadMaps ignores document.npcs; LoadNpcs always begins from filesystem placements and only overlays sparse published entities.",
    "consequence": [
      "A DB row with npcs: [] does not suppress stale file NPCs.",
      "A non-empty canonical DB NPC edit is ignored at runtime.",
      "DB-row absence cannot be distinguished from an authoritative empty canonical NPC list at the runtime placement seam."
    ]
  },
  "required_precedence": [
    "canonical DB row present -> canonical npcs is base, including []",
    "canonical DB row absent -> filesystem npcs fallback is base",
    "sparse published NPC override -> wins after base selection at matching coordinate"
  ],
  "tests": [
    {
      "id": "A",
      "db": "present_empty",
      "file": "nonempty",
      "sparse": "none",
      "expect": "zero_file_npcs_for_map"
    },
    {
      "id": "B",
      "db": "present_nonempty",
      "file": "different_nonempty",
      "sparse": "none",
      "expect": "canonical_only"
    },
    {
      "id": "C",
      "db": "absent",
      "file": "nonempty",
      "sparse": "none",
      "expect": "file_fallback"
    },
    {
      "id": "D",
      "db": "present_nonempty",
      "file": "any",
      "sparse": "same_coordinate",
      "expect": "sparse_wins"
    },
    {
      "id": "E",
      "db": "present_nonempty",
      "file": "any",
      "sparse": "same_coordinate",
      "expect": "one_runtime_placement_no_duplicate"
    },
    {
      "id": "F",
      "db": "canonical_with_movement",
      "file": "any",
      "sparse": "none",
      "expect": "movement_preserved"
    }
  ],
