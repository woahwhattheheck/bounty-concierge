{
  "name": "@tryabby/vue",
  "version": "0.1.0",
  "description": "Typed Vue composables for Abby A/B tests, feature flags and remote configuration",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "license": "ISC",
  "dependencies": {
    "@tryabby/core": "workspace:*",
    "js-cookie": "^3.0.1"
  },
  "peerDependencies": { "vue": "^3.5.0" },
  "devDependencies": {
    "@types/js-cookie": "^3.0.3",
    "@types/node": "^22.0.0",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^20.0.3",
    "tsup": "^6.5.0",
    "typescript": "5.5.4",
    "vite": "5.4.0",
    "vitest": "2.0.5",
    "vue": "^3.5.0"
  }
}
